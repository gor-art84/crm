{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "prisma:format": {
      "cache": false
    },
    "prisma:generate": {},
    "prisma:validate": {},
    "prisma:migrate": {
      "cache": false
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true
    },
    "prisma:seed": {
      "cache": false,
      "env": ["DATABASE_URL", "ADMIN_EMAIL", "ADMIN_PASSWORD"]
    },
    "codegen": {
      "cache": false
    },
    "codegen:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
