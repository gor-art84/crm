{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "prisma:format": {
      "cache": false
    },
    "prisma:seed": {
      "cache": false,
      "env": ["DATABASE_URL", "ADMIN_EMAIL", "ADMIN_PASSWORD"]
    }
  }
}
