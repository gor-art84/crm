enum ClientType {
  LEGAL_ENTITY
  INDIVIDUAL_ENTREPRENEUR
  INDIVIDUAL
}

enum PartyStatus {
  ACTIVE
  LIQUIDATING
  LIQUIDATED
  BANKRUPT
  REORGANIZING
}

model Client {
  id               String     @id @default(uuid())
  fullName         String
  shortName        String?
  type             ClientType
  inn              String?
  kpp              String?
  ogrn             String?
  okpo             String?
  okved            String?
  lastName         String?
  firstName        String?
  middleName       String?
  legalAddress     String?
  actualAddress    String?
  phone            String?
  email            String?
  directorName     String?
  directorPosition String?
  website          String?
  status           PartyStatus?
  employeeCount    Int?
  dadataJson       Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt


  @@unique([inn])

  @@index([type])
  @@index([createdAt])
}
