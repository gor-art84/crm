meta {
  name: updateMyProfile-role-rejected
  type: graphql
  seq: 3
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ($i: UpdateMyProfileInput!) {
    updateMyProfile(input: $i) {
      role
    }
  }
}

body:graphql:vars {
  { "i": { "role": "ADMINISTRATOR" } }
}

assert {
  res.body.errors[0].extensions.code: eq BAD_USER_INPUT
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
