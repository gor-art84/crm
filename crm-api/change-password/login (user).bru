meta {
  name: login (user)
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation Login($input: LoginInput!){
    login(input: $input) {
      id
      role
    }
  }
}

body:graphql:vars {
  {"input": {"email": "{{userEmail}}", "password": "{{newPassword}}"}}
}

assert {
  res.body.data.login.role: eq METHODIST
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
