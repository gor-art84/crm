meta {
  name: same password
  type: graphql
  seq: 4
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation ChangePassword($input: ChangePasswordInput!) {
    changePassword(input: $input)
  }
}

body:graphql:vars {
  {"input": {"newPassword": "{{userPassword}}", "currentPassword": "{{userPassword}}"}}
}

assert {
   res.body.errors[0].message: eq Новый пароль должен отличаться от старого
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
