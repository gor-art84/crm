meta {
  name: login
  type: graphql
  seq: 1
}

post {
  url: {{baseUrl}}/graphql
  body: graphql
  auth: inherit
}

body:graphql {
  mutation Login($input: LoginInput!){
    login(input: $input) {
      id
      role
    }
  }
}

body:graphql:vars {
  {"input": {"email": "{{adminEmail}}", "password": "{{adminPassword}}"}}
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
